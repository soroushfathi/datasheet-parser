# Use an SSH tunnel if MongoDB only listens on dana's loopback interface.
DATASHEET_MONGO_URI=mongodb://127.0.0.1:27018/?directConnection=true
DATASHEET_DATABASE=datasheet_dev
DATASHEET_WORK_DIR=./work
DATASHEET_PROVIDER=codex
DATASHEET_MODEL=gpt-6-astra
DATASHEET_REASONING=high
DATASHEET_LLM_TIMEOUT=600
DATASHEET_LLM_ATTEMPTS=3
# Optional proxy for the Codex child process only; leave empty for direct/system routing.
DATASHEET_CODEX_PROXY=
# Set an absolute executable path if Codex is available in the desktop app but not your terminal PATH.
DATASHEET_CODEX_EXECUTABLE=
# Only required for --provider openai. Never committed or passed to Codex.
OPENAI_API_KEY=
