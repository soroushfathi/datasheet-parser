# Use an SSH tunnel if MongoDB only listens on dana's loopback interface.
DATASHEET_MONGO_URI=mongodb://127.0.0.1:27018/?directConnection=true
DATASHEET_DATABASE=datasheet_dev
DATASHEET_WORK_DIR=./work
DATASHEET_PROVIDER=codex
DATASHEET_MODEL=gpt-6-astra
DATASHEET_REASONING=high
DATASHEET_LLM_TIMEOUT=600
DATASHEET_LLM_ATTEMPTS=3
# openai-chat: cancellable total wall budget includes all stream attempts/backoff.
# 0 preserves the legacy transport. Sample server uses total 240 / attempt 240 / 2 attempts.
DATASHEET_LLM_STAGE_DEADLINE=0
DATASHEET_LLM_ATTEMPT_DEADLINE=180
DATASHEET_ISOLATE_STAGE_FAILURES=false
# New runs use source chunks + Contextual BM25; legacy keeps full-document prompts.
DATASHEET_PIPELINE=retrieval-v2
DATASHEET_RETRIEVAL_TOP_K=6
# Baseline character metric; optimized runs budget complete source bundles in tokens.
DATASHEET_PACKET_TEXT_BUDGET=60000
DATASHEET_OPTIMIZATION=budget-v1
# Source glyph repair, initial figure inventory, semantic guards and auditable review.
# Only new optimized runs use this version; resume keeps the stored run version.
DATASHEET_QUALITY=quality-v1
DATASHEET_PACKET_TOKEN_BUDGET=6000
# Image estimate is a geometry proxy, not provider-billed vision token accounting.
DATASHEET_PACKET_IMAGE_TOKEN_BUDGET=6000
DATASHEET_PACKET_MAX_IMAGES=6
DATASHEET_REQUEST_TOKEN_BUDGET=20000
# Optional locally installed SentenceTransformer/CrossEncoder model paths. No API key needed.
DATASHEET_EMBEDDING_MODEL=
DATASHEET_RERANKER_MODEL=
# true prevents unexpected model downloads; false permits initial Hugging Face download.
DATASHEET_RETRIEVAL_LOCAL_ONLY=true
# Global inference concurrency for new runs: 1, 2 or 3. Resume keeps the recorded value.
DATASHEET_WORKERS=2
# Optional proxy for the Codex child process only; leave empty for direct/system routing.
DATASHEET_CODEX_PROXY=
# Set an absolute executable path if Codex is available in the desktop app but not your terminal PATH.
DATASHEET_CODEX_EXECUTABLE=
# Only required for --provider openai. Never committed or passed to Codex.
OPENAI_API_KEY=
# Optional compatible router; --provider openai-chat uses Chat Completions + vision/schema.
# Leave unset for the standard OpenAI endpoint. Never put an API key in browser code.
# OPENAI_BASE_URL=https://ai-router.intelcad.ai/v1
